// Render Quiz Questions
function renderQuiz() {
    const container = document.getElementById('quiz-container');
    container.innerHTML = '';

    questions.forEach((q, index) => {
        const card = document.createElement('div');
        card.className = 'question-card';
        card.id = `q-card-${q.id}`;

        let optionsHTML = '';
        for (const [key, value] of Object.entries(q.options)) {
            optionsHTML += `
                <label class="option" id="label-${q.id}-${key}">
                    <input type="radio" name="q${q.id}" value="${key}">
                    <strong>${key}.</strong>&nbsp;${value}
                </label>
            `;
        }

        card.innerHTML = `
            <div class="question-number">Câu ${index + 1} (Question ${q.id})</div>
            <div class="sign-box">${q.sign}</div>
            <div class="options">
                ${optionsHTML}
            </div>
            <div class="explanation" id="explain-${q.id}">
                ${q.explanation}
            </div>
        `;

        container.appendChild(card);
    });
}

// Grade Quiz and Calculate Score
function gradeQuiz() {
    let score = 0;

    questions.forEach(q => {
        const selected = document.querySelector(`input[name="q${q.id}"]:checked`);
        const explanation = document.getElementById(`explain-${q.id}`);

        // Reset styling
        Object.keys(q.options).forEach(key => {
            const label = document.getElementById(`label-${q.id}-${key}`);
            label.classList.remove('correct', 'incorrect');
        });

        if (selected) {
            const userAns = selected.value;
            if (userAns === q.answer) {
                score++;
                document.getElementById(`label-${q.id}-${userAns}`).classList.add('correct');
            } else {
                document.getElementById(`label-${q.id}-${userAns}`).classList.add('incorrect');
                document.getElementById(`label-${q.id}-${q.answer}`).classList.add('correct');
            }
        } else {
            // Highlight correct answer if skipped
            document.getElementById(`label-${q.id}-${q.answer}`).classList.add('correct');
        }

        // Show explanation
        explanation.style.display = 'block';
    });

    // Display total score
    const scoreBoard = document.getElementById('score-board');
    const scoreText = document.getElementById('score-text');
    scoreText.innerText = `KẾT QUẢ: ${score} / ${questions.length} CÂU ĐÚNG (${((score / questions.length) * 10).toFixed(1)} ĐIỂM)`;
    scoreBoard.style.display = 'block';

    // Scroll to top score board
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Initialize
renderQuiz();
