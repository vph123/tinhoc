}

// Xuất file từ vựng mới
function exportVocabFile() {
    const checkboxes = document.querySelectorAll('.vocab-checkbox:checked');
    if (checkboxes.length === 0) {
        alert('Vui lòng chọn ít nhất 1 từ vựng để lưu trữ!');
        return;
    }

    let fileContent = "==================================================\n";
    fileContent += "   BỘ TỪ VỰNG TIẾNG ANH ĐẦU VÀO IUH - BUỔI 1\n";
    fileContent += "   Phân tích ngữ cảnh tự động bằng AI Gemini\n";
    fileContent += "==================================================\n\n";

    checkboxes.forEach((cb, index) => {
        const word = cb.getAttribute('data-word');
        const ipa = cb.getAttribute('data-ipa');
        const pos = cb.getAttribute('data-pos');
        const meaning = cb.getAttribute('data-meaning');
        const context = cb.getAttribute('data-context');

        fileContent += `${index + 1}. ${word.toUpperCase()} (${pos})\n`;
        fileContent += `   - Phiên âm: ${ipa}\n`;
        fileContent += `   - Nghĩa trong bài: ${meaning}\n`;
        fileContent += `   - Ngữ cảnh: "${context}"\n\n`;
    });

    // Tạo file đao-loat về máy
    const blob = new Blob([fileContent], { type: 'text/plain;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'Tu_Vung_IUH_Buoi_1.txt';
    link.click();
}

