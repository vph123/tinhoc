            display: none;
            background: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border: 2px solid var(--primary-color);
        }

        #score-board h2 {
            margin: 0 0 10px 0;
            color: var(--primary-color);
        }

        #score-board p {
            margin: 0;
            font-size: 16px;
            color: #555;
        }
    </style>
</head>
